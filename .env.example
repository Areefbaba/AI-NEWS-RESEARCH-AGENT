# Application Environment Configuration
APP_NAME="AI News & Research Agent"
ENV=development
DEBUG=false

# Storage & Caching
DATABASE_PATH=data/news_agent.db
CACHE_TTL_HOURS=6
DEFAULT_TIME_WINDOW_HOURS=48

# Multi-Model LLM Providers & Fallback Chain
# Priority order: groq -> gemini -> openai -> ollama -> heuristic
LLM_FALLBACK_ORDER=groq,gemini,openai,ollama,heuristic
SUMMARY_TARGET_WORD_COUNT=200

# 1. Groq Cloud (High-speed Llama-3.3-70B)
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Gemini-1.5-Flash)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenAI (GPT-4o-mini)
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini

# 4. Local Ollama / Qwen LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=30.0

# Optional Web Search Integrations
SEARCH_PROVIDER=none
SEARCH_API_KEY=""

# HTTP Client Settings
REQUEST_TIMEOUT_SECONDS=12.0
MAX_RETRIES=2
